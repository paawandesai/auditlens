# AuditLens AI — Environment Configuration
# Copy this to .env and fill in your values

# Supabase
AUDITLENS_SUPABASE_URL=https://your-project.supabase.co
AUDITLENS_SUPABASE_ANON_KEY=your-anon-key
AUDITLENS_SUPABASE_SERVICE_KEY=your-service-key

# App
AUDITLENS_ENVIRONMENT=development
AUDITLENS_ALLOWED_ORIGINS=["http://localhost:3000"]

# GitHub (for repo scanning)
GITHUB_TOKEN=your-github-pat

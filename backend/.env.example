# GitHub Personal Access Token (optional — increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Allowed CORS origins (JSON array of frontend URLs)
# In production, set to your Vercel frontend URL
AUDITLENS_ALLOWED_ORIGINS=["https://your-frontend.vercel.app"]

# Environment: "development" or "production"
# In production, ONLY configured origins are allowed (no localhost fallback)
AUDITLENS_ENV=production

# Port (Render sets this automatically)
PORT=8000

# --- Authentication ---
# JWT secret for token signing/verification (min 32 chars recommended)
AUDITLENS_JWT_SECRET=your-secret-key-at-least-32-characters-long

# API keys (comma-separated) — alternative to JWT for programmatic access
AUDITLENS_API_KEYS=key-abc-123,key-def-456

# Set to "false" to disable auth entirely (development only!)
# AUDITLENS_AUTH_ENABLED=false

# --- Rate Limiting ---
# Format: "N/period" where period is second, minute, hour, day
RATE_LIMIT_SCAN=10/minute
RATE_LIMIT_READ=60/minute
RATE_LIMIT_DEFAULT=100/minute
